amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"

// The full gate CI runs, defined once in mise.toml's `ci` task.
local ci = new Mapping<String, Step> {
    ["mise_ci"] {
        glob = List("**/*.rs", "**/Cargo.toml", "Cargo.lock", "mise.toml", "clippy.toml", ".config/nextest.toml", "third_party/**")
        check = "mise run ci"
        exclusive = true
    }
}

// Every crate under crates/ but the `<x>-it` crates (listed in `tested`
// below), each directory named after its package. hk's built-in Pkl
// evaluator has no `read*`, so a new crate is added here by hand. The
// `unlisted-crate` step fails the pre-commit hook when a staged file lies
// under a crates/ directory missing from both lists, naming hk.pkl.
local crates = List(
    "nova",
    "nova-appkit",
    "nova-audio",
    "nova-bundle",
    "nova-data",
    "nova-disasm",
    "nova-dump",
    "nova-galaxy-format",
    "nova-galaxy-media",
    "nova-ink",
    "nova-metalfx",
    "nova-movie",
    "nova-render",
    "nova-rsrc",
    "nova-sim",
    "nova-sim-ai",
    "nova-sim-base",
    "nova-sim-catalog",
    "nova-sim-combat",
    "nova-sim-port",
    "nova-sim-state",
    "nova-sim-story",
    "nova-view",
    "nova-win32",
    "nova-winres",
)

// The crates whose integration tests live in a sibling `<x>-it` crate
// (crates/<x>-it), moved out of `<x>` so that `<x>`'s unit-test build
// doesn't wait on a second, `fixture`-on build of its own library
// (faster-builds). Each gets an `<x>-it` step below, which a commit to
// either crate runs. hk's built-in evaluator can't call a string method
// with arguments, so the list names `<x>` and the step adds `-it`.
local tested = List(
    "nova-sim",
    "nova-view",
)

// The pre-commit gate: fmt, then clippy and nextest over each crate with
// staged changes, one `-p` at a time. A single `-p <crate>` keeps one
// feature-resolved build of each crate warm; a combined `-p a -p b` would
// build a new variant for every combination. `exclusive` runs the crates
// one after another rather than contending for the target-dir lock.
// Dependent crates, the dev-tools legs and doctests are left to the full
// gate (`hk check`, `mise run ci`), run before review and on landing. The
// one exception is an `<x>-it` crate: it holds `<x>`'s own integration
// tests, not a dependent's, so a commit to `<x>` runs them as it did when
// they lived in `<x>`. Every other dependent still waits for the full gate.
local changed = new Mapping<String, Step> {
    ["fmt"] {
        glob = List("**/*.rs")
        check = "cargo fmt --all --check"
        exclusive = true
    }
    for (c in crates) {
        [c] {
            glob = List("crates/\(c)/**")
            check = "cargo clippy -p \(c) --all-targets --locked -- -D warnings && cargo nextest run -p \(c) --locked --no-tests=pass"
            exclusive = true
        }
    }
    for (t in tested) {
        ["\(t)-it"] {
            glob = List("crates/\(t)-it/**", "crates/\(t)/**")
            check = "cargo clippy -p \(t)-it --all-targets --locked -- -D warnings && cargo nextest run -p \(t)-it --locked --no-tests=pass"
            exclusive = true
        }
    }
    // Fails when a staged file sits in a crate this list doesn't name, so a
    // new crate can't silently get fmt only.
    ["unlisted-crate"] {
        glob = List("crates/**")
        exclude = crates.map((c) -> "crates/\(c)/**") + tested.map((t) -> "crates/\(t)-it/**")
        check = "echo 'error: {{files}} is in a crate missing from the crates list in hk.pkl; add the crate there' >&2; exit 1"
        exclusive = true
    }
    // Files that can change every crate's build or tests. third_party/ holds
    // the vendored FFmpeg bindings and the FFmpeg source record, which
    // every build reaching the movie decoder builds.
    ["workspace"] {
        glob = List("Cargo.toml", "Cargo.lock", "mise.toml", "clippy.toml", ".config/nextest.toml", ".cargo/**", "third_party/**")
        check = "mise run lint && mise run test"
        exclusive = true
    }
}

// Check-only: the hooks report problems but never rewrite staged files.
hooks {
    ["pre-commit"] {
        steps = changed
    }
    ["check"] {
        steps = ci
    }
}
