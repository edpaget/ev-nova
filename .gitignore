/target
# Original game (copyrighted Ambrosia data) — kept locally, never committed.
/EV Nova.app
.DS_Store
mutants.out*/
# Windows Community Edition data (.rez files, copyrighted) — local only.
/windows-data
# Lore notes live in the sibling ev-nova-notes repo; a local symlink may point there.
/notes
# Local helper script to build and run nova.
/run-nova.sh
# `mise run bundle -- dist`'s .dmg, the nightly workflow's macOS Package step.
/dist
# infra/github's OpenTofu working files. The state is encrypted but still
# never committed; .terraform.lock.hcl is committed.
infra/github/.terraform/
infra/github/*.tfstate
infra/github/*.tfstate.*
infra/github/*.tfplan
infra/github/.terraform.tfstate.lock.info
infra/github/crash*.log
# The same for infra/windows-signing.
infra/windows-signing/.terraform/
infra/windows-signing/*.tfstate
infra/windows-signing/*.tfstate.*
infra/windows-signing/*.tfplan
infra/windows-signing/.terraform.tfstate.lock.info
infra/windows-signing/crash*.log
# Per-machine mise settings, e.g. OP_ACCOUNT for the infra-* tasks.
mise.local.toml
